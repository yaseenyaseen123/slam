<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>سلام حمود | الرئيسية</title>
  <style>
    :root {
      --bg: #120d2a;
      --panel: rgba(255,255,255,0.06);
      --panel-strong: rgba(255,255,255,0.12);
      --gold: #d4af37;
      --purple: #8b5cf6;
      --text: #f5f5f5;
      --muted: #d7d7d7;
      --shadow: rgba(0,0,0,0.25);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: 'Tahoma', 'Segoe UI', sans-serif;
      background: linear-gradient(135deg, #150f31, #2b1c5d 45%, #4c2a7f);
      color: var(--text);
      min-height: 100vh;
    }
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background: url('new_background.png') center/cover no-repeat;
      opacity: 0.18;
      filter: blur(2px);
      z-index: 0;
    }
    .container {
      position: relative;
      z-index: 1;
      max-width: 1100px;
      margin: 0 auto;
      padding: 24px 18px 48px;
    }
    nav {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
      padding: 18px 12px;
      margin: 0 auto 24px;
      background: rgba(0,0,0,0.25);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 16px;
      backdrop-filter: blur(6px);
      position: sticky;
      top: 10px;
      z-index: 10;
    }
    nav a {
      color: var(--text);
      text-decoration: none;
      padding: 10px 18px;
      border-radius: 999px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.06);
      transition: 0.25s ease;
      font-size: 0.96rem;
    }
    nav a:hover { background: rgba(212,175,55,0.18); }
    .hero {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 28px;
      align-items: center;
      background: rgba(15,15,20,0.3);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 24px;
      padding: 32px;
      box-shadow: 0 20px 50px var(--shadow);
    }
    .badge {
      display: inline-block;
      padding: 8px 14px;
      border-radius: 999px;
      background: rgba(212,175,55,0.16);
      color: var(--gold);
      font-weight: 700;
      font-size: 0.82rem;
      margin-bottom: 12px;
    }
    h1 {
      font-size: clamp(2rem, 4vw, 4.2rem);
      margin: 0 0 12px;
      line-height: 1.15;
    }
    .subtitle {
      color: var(--muted);
      font-size: 1.1rem;
      line-height: 1.8;
      margin: 0 0 22px;
    }
    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 20px;
    }
    .btn {
      display: inline-block;
      border: none;
      text-decoration: none;
      border-radius: 999px;
      padding: 12px 18px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .btn.primary {
      background: linear-gradient(135deg, var(--gold), #f0c95a);
      color: #1b1b1b;
    }
    .btn.secondary {
      background: rgba(255,255,255,0.08);
      color: var(--text);
      border: 1px solid rgba(255,255,255,0.12);
    }
    .btn:hover { transform: translateY(-1px); }
    .profile-box {
      text-align: center;
      padding: 20px;
    }
    .profile-box img {
      width: min(100%, 360px);
      aspect-ratio: 1 / 1;
      border-radius: 50%;
      object-fit: cover;
      border: 4px solid rgba(212,175,55,0.8);
      box-shadow: 0 18px 40px rgba(0,0,0,0.35);
    }
    .section {
      margin-top: 32px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 22px;
      padding: 26px 22px;
    }
    .section h2 {
      margin: 0 0 20px;
      font-size: clamp(1.5rem, 2vw, 2.3rem);
      color: var(--gold);
    }
    .cards, .programs, .gallery-grid, .video-grid {
      display: grid;
      gap: 18px;
    }
    .cards {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
    .card {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 18px;
      padding: 18px;
    }
    .card .icon { font-size: 2rem; margin-bottom: 8px; }
    .card h3 { margin: 0 0 8px; font-size: 1.15rem; }
    .card p { margin: 0; color: var(--muted); line-height: 1.8; }
    .programs {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    }
    .program {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 18px;
      padding: 18px;
    }
    .program h3 { margin: 0 0 8px; }
    .program p { margin: 0; color: var(--muted); line-height: 1.8; }
    .gallery-grid {
      grid-template-columns: repeat(auto-fit, minmax(170px,1fr));
    }
    .gallery-grid img {
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      border-radius: 16px;
      border: 1px solid rgba(255,255,255,0.08);
      cursor: pointer;
      transition: transform 0.2s ease;
    }
    .gallery-grid img:hover { transform: scale(1.02); }
    .video-grid {
      grid-template-columns: repeat(auto-fit, minmax(260px,1fr));
    }
    .video-card {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 18px;
      overflow: hidden;
    }
    iframe {
      width: 100%;
      height: 220px;
      border: 0;
      display: block;
    }
    .video-card h3 {
      padding: 12px 14px 0;
      margin: 0 0 8px;
      font-size: 1.02rem;
    }
    .video-card p {
      padding: 0 14px 14px;
      margin: 0;
      color: var(--muted);
      line-height: 1.6;
    }
    .social-list {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      padding: 0;
      margin: 0;
      list-style: none;
    }
    .social-list a {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 12px 18px;
      border-radius: 999px;
      text-decoration: none;
      color: var(--text);
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.07);
    }
    .empty {
      color: var(--muted);
      padding: 16px 0;
    }
    @media (max-width: 720px) {
      .hero { grid-template-columns: 1fr; }
      nav { justify-content: flex-start; }
    }
  </style>
</head>
<body>
  <div class="container">
    <nav>
      <a href="index.html">الرئيسية</a>
      <a href="gallery.html">المعرض</a>
      <a href="videos.html">الفيديوهات</a>
      <a href="social.html">تواصل معنا</a>
      <a href="guestbook.html">بصمات الزوار</a>
      <a href="admin.html">لوحة التحكم</a>
    </nav>

    <section class="hero">
      <div>
        <div class="badge">إعلامية | مقدمة برامج | مدربة صوت</div>
        <h1 id="site-name">سلام حمود</h1>
        <p class="subtitle" id="site-subtitle">الإعلامية القديرة | مذيعة ومعدة برامج</p>
        <p class="subtitle" id="site-description">خبرة تزيد عن 15 عامًا في مجال الإعلام.</p>
        <div class="actions">
          <a class="btn primary" href="social.html">تواصل معي</a>
          <a class="btn secondary" href="gallery.html">استعرض الصور</a>
        </div>
      </div>
      <div class="profile-box">
        <img id="profile-image" src="profile_image_new.jpg" alt="سلام حمود" />
      </div>
    </section>

    <section class="section">
      <h2>من هي سلام حمود؟</h2>
      <div id="about-cards" class="cards"></div>
    </section>

    <section class="section">
      <h2>برامجها</h2>
      <div id="programs" class="programs"></div>
    </section>

    <section class="section">
      <h2>المعرض</h2>
      <div id="gallery" class="gallery-grid"></div>
    </section>

    <section class="section">
      <h2>أحدث الفيديوهات</h2>
      <div id="videos" class="video-grid"></div>
    </section>

    <section class="section">
      <h2>التواصل الاجتماعي</h2>
      <ul id="social-links" class="social-list"></ul>
    </section>
  </div>

  <script>
    const defaultData = {
      basic: {
        name: 'سلام حمود',
        subtitle: 'الإعلامية القديرة | مذيعة ومعدة برامج',
        description: 'خبرة تزيد عن 15 عامًا في مجال الإعلام، متخصصة في فن الإلقاء والخطابة والتعليق الصوتي والبودكاست.',
        profileImage: 'profile_image_new.jpg'
      },
      infoCards: [
        { icon: '👤', title: 'من هي سلام حمود؟', content: 'سلام حمود إعلامية لبنانية ذات خبرة واسعة في المجال الإعلامي والتقديم والحوارات.' },
        { icon: '🎓', title: 'المسيرة التعليمية', content: 'درست التسويق والعلاقات العامة، ما منحها قاعدة قوية في فهم الجمهور والتأثير عليه.' },
        { icon: '🎙️', title: 'بداية الطريق الإعلامي', content: 'بدأت مسيرتها الإعلامية في لبنان ثم توسعت في الخليج والفضاءات الإعلامية الناطقة بالعربية.' },
        { icon: '💫', title: 'رسالتها', content: 'تؤمن سلام بأن الميكروفون أمانة، وأن الإعلام الحقيقي يبني الوعي وينقل الإنسان.' }
      ],
      programs: [
        { title: 'عالطريق مع سلام', description: 'برنامج حواري اجتماعي وثقافي يناقش قضايا المجتمع والناس.', note: 'راديو الرابعة' },
        { title: 'بودكاست مع سلام', description: 'بودكاست حول الإنسان، التغيير، والنجاح.', note: 'منصات صوتية' },
        { title: 'مقابلات ومشاهدات', description: 'جلسات حوار مع ضيوف ومبدعين من مختلف المجالات.', note: 'محتوى حيوي' }
      ],
      gallery: [
        'salam_hammoud.jpg',
        'salam_new_img1.jpg',
        'salam_new_img2.jpg',
        'salam_new_img3.jpg',
        'salam_new_img4.jpg',
        'salam_new_img5.jpg'
      ],
      videos: [
        { id: 'M9tQ0yM9sLY', title: 'الإنسان مقيد ��م حر؟', description: 'نقاش فلسفي عميق حول الحرية والقيود.' },
        { id: '8Z9SuAR7QJw', title: 'بودكاست مع سلام', description: 'حوار حي مع ضيف مميز.' }
      ],
      social: {
        instagram: 'https://instagram.com/salam_hammoud',
        tiktok: 'https://www.tiktok.com/@salam_hammoud',
        youtube: 'https://youtube.com/@salamhammoud9',
        facebook: 'https://facebook.com/Salam.Hammoud.Anchor',
        twitter: 'https://twitter.com/SalamHam'
      }
    };

    const safe = (value, fallback) => (value === undefined || value === null || value === '') ? fallback : value;

    function renderAboutCards(items) {
      const container = document.getElementById('about-cards');
      if (!Array.isArray(items) || !items.length) {
        container.innerHTML = '<div class="empty">لا توجد بيانات متاحة.</div>';
        return;
      }
      container.innerHTML = items.map(item => `
        <article class="card">
          <div class="icon">${safe(item.icon, '✦')}</div>
          <h3>${safe(item.title, 'عنوان')}</h3>
          <p>${safe(item.content, 'بدون وصف')}</p>
        </article>
      `).join('');
    }

    function renderPrograms(items) {
      const container = document.getElementById('programs');
      if (!Array.isArray(items) || !items.length) {
        container.innerHTML = '<div class="empty">لا توجد برامج حالياً.</div>';
        return;
      }
      container.innerHTML = items.map(item => `
        <article class="program">
          <h3>${safe(item.title, 'برنامج')}</h3>
          <p>${safe(item.description, 'لا يوجد وصف')}</p>
          <p>${safe(item.note, '')}</p>
        </article>
      `).join('');
    }

    function renderGallery(items) {
      const container = document.getElementById('gallery');
      if (!Array.isArray(items) || !items.length) {
        container.innerHTML = '<div class="empty">لا توجد صور بعد.</div>';
        return;
      }
      container.innerHTML = items.map(item => `
        <img src="${item}" alt="صورة" loading="lazy" />
      `).join('');
    }

    function renderVideos(items) {
      const container = document.getElementById('videos');
      if (!Array.isArray(items) || !items.length) {
        container.innerHTML = '<div class="empty">لا توجد فيديوهات حالياً.</div>';
        return;
      }
      container.innerHTML = items.map(item => {
        const embed = item.url || `https://www.youtube.com/embed/${item.id}`;
        return `
          <article class="video-card">
            <iframe src="${embed}" allowfullscreen title="${safe(item.title, 'فيديو')}"></iframe>
            <h3>${safe(item.title, 'فيديو')}</h3>
            <p>${safe(item.description, '')}</p>
          </article>
        `;
      }).join('');
    }

    function renderSocials(items) {
      const container = document.getElementById('social-links');
      if (!items || typeof items !== 'object') {
        container.innerHTML = '<li class="empty">لا توجد روابط.</li>';
        return;
      }
      const entries = [
        ['Instagram', items.instagram, '📷'],
        ['TikTok', items.tiktok, '🎵'],
        ['YouTube', items.youtube, '▶️'],
        ['Facebook', items.facebook, '👥'],
        ['Twitter', items.twitter, '🐦']
      ].filter(([label, href]) => label && href);
      container.innerHTML = entries.map(([label, href, icon]) => `
        <li><a href="${href}" target="_blank" rel="noreferrer">${icon} ${label}</a></li>
      `).join('');
    }

    async function loadData() {
      try {
        const response = await fetch('./comments.json', { cache: 'no-store' });
        const data = response.ok ? await response.json() : defaultData;
        const siteData = data && typeof data === 'object' ? data : defaultData;
        document.getElementById('site-name').textContent = safe(siteData.basic?.name, defaultData.basic.name);
        document.getElementById('site-subtitle').textContent = safe(siteData.basic?.subtitle, defaultData.basic.subtitle);
        document.getElementById('site-description').textContent = safe(siteData.basic?.description, defaultData.basic.description);
        const profileImage = safe(siteData.basic?.profileImage, defaultData.basic.profileImage);
        document.getElementById('profile-image').src = profileImage;
        renderAboutCards(siteData.infoCards || defaultData.infoCards);
        renderPrograms(siteData.programs || defaultData.programs);
        renderGallery(siteData.gallery || defaultData.gallery);
        renderVideos(siteData.videos || defaultData.videos);
        renderSocials(siteData.social || defaultData.social);
      } catch (error) {
        console.error('Error loading site data', error);
        document.getElementById('site-name').textContent = defaultData.basic.name;
        document.getElementById('site-subtitle').textContent = defaultData.basic.subtitle;
        document.getElementById('site-description').textContent = defaultData.basic.description;
        renderAboutCards(defaultData.infoCards);
        renderPrograms(defaultData.programs);
        renderGallery(defaultData.gallery);
        renderVideos(defaultData.videos);
        renderSocials(defaultData.social);
      }
    }

    document.addEventListener('DOMContentLoaded', loadData);
  </script>
</body>
</html>
